            "description": "Auto-incremental identifier of the audit record. It's the PK of audit.logged_actions and is used to reference a specific event.",
            "example": "#1234"
          },
          "schema_name": {
            "title": "Schema",
            "description": "Schema of the database where the audited table lives (e.g.: auth, audit, public).",
            "example": "auth"
          },
          "table_name": {
            "title": "Table",
            "description": "Name of the table where the change occurred, without schema prefix.",
            "example": "roles"
          },
          "relid": {
            "title": "Table OID",
            "description": "Postgres internal table identifier (table OID). It changes if the table is DROP + CREATE, that's why you normally filter by table_name rather than relid.",
            "example": "16453"
          },
          "session_user_name": {
            "title": "Postgres session user",
            "description": "User that opened the JDBC connection (the one in the JDBC_URL). NOT your application's logged-in user. To know who made the change at the app level, look at created_by / last_modified_by in the audited table.",
            "example": "ucaapp_user"
          },
          "action_tstamp_tx": {
            "title": "Transaction start",
            "description": "Timestamp when the transaction that triggered the event started. All events of the same transaction share this value — useful for grouping related changes.",
            "example": "05/28/2026 14:32:10"
          },
          "action_tstamp_stm": {
            "title": "Statement start",
            "description": "Timestamp of the start of the specific SQL statement within the transaction. If a transaction runs multiple statements, each has its own."
          },
          "action_tstamp_clk": {
            "title": "Trigger clock",
            "description": "Wall-clock of the exact moment the trigger fired. It's the most precise of the three timestamps; useful for correlating with Spring logs."
          },
          "transaction_id": {
            "title": "Transaction ID",
            "description": "Postgres transaction identifier (txid_current). Combined with action_tstamp_tx, it lets you group all changes that came in together.",
            "example": "892341"
          },
          "application_name": {
            "title": "Client application",
            "description": "Name the client assigned to itself when connecting to Postgres. Helps distinguish changes made by the app (PostgreSQL JDBC Driver) vs tools like pgAdmin, DBeaver or psql.",
            "example": "PostgreSQL JDBC Driver"
          },
          "client_addr": {
            "title": "Client IP",
            "description": "IP address that opened the connection to Postgres. In Docker setups without real IP propagation, you'll always see the Spring container IP (e.g.: 172.x.x.x) or the Docker gateway (e.g.: 192.168.65.1).",
            "example": "192.168.65.1"
          },
          "client_port": {
            "title": "Client port",
            "description": "Ephemeral port used by the client when connecting. Of little practical use; only relevant for network forensics."
          },
          "client_query": {
            "title": "Full SQL query",
            "description": "The exact SQL that triggered the change (the client's top-level query). Useful when you need to reproduce or understand what was executed.",
            "example": "UPDATE auth.roles SET name = ? WHERE id = ?"
          },
          "action": {
            "title": "Operation type",
            "description": "Letter indicating the type of change: I = INSERT (creation), U = UPDATE (modification), D = DELETE (deletion), T = TRUNCATE (mass empty).",
            "example": "U"
          },
          "row_data": {
            "title": "Row data",
            "description": "hstore snapshot (key/value) of the affected row. On INSERT contains the NEW row; on UPDATE and DELETE contains the OLD row (before the change). This is what lets you reconstruct the previous state."
          },
          "changed_fields": {
            "title": "Changed fields",
            "description": "Only for UPDATE: hstore with the NEW values of the columns that actually changed. If you compare row_data vs changed_fields you get the exact delta of the UPDATE."
          },
          "statement_only": {
            "title": "Statement only",
            "description": "If true, it means the event came from a statement-level trigger (not row-level). Typically only appears in TRUNCATE. For normal INSERT/UPDATE/DELETE it's false."
          }
        }
      },
